print("==== index() ====")

# 특정 문자열의 위치(인덱스 번호)를 반환
# 앞에서부터 가장 처음 나오는 인덱스 번호만 반환
# 찾는 문자열이 없으면 Error 발생

email = "layla@spreatics.com"
at = email.index("@")
print(email[0:at])
print(email[0:at])  # 시작 번호가 0이라면 start 생략 가능
print(email[at:])  # 끝까지 출력하고 싶고, 뒤에 몇 글자가 있는지 모르니 생략
print(
    email[at + 1 :]
)  # 위처럼 시작하면 5번 인덱스 부터 출력하기 떄문에 @을 포함, 따라서 at +1을하면 at을 포함하지 않고 출력함


